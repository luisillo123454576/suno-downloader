# ==========================================
# ARCHIVO DE CONFIGURACIÓN DE VARIABLES (.env)
# ==========================================

# Puerto donde correrá el servidor web / móvil (por defecto: 8000)
PORT=8000

# Carpeta de descargas local (si se deja vacío, usa "downloads" en la raíz del proyecto)
DOWNLOADS_DIR=

# [OPCIONAL] Cookie de sesión de tu cuenta en Suno.com (para descargar temas privados)
# Para obtenerla: Entra a suno.com, abre DevTools (F12) -> Red/Network -> copia el valor del header 'Cookie'
SUNO_COOKIE=

# [OPCIONAL] Token Bearer JWT de Suno (Authorization: Bearer <TOKEN>)
# Para obtenerlo: En DevTools (F12) -> Red/Network -> busca llamadas a studio-api.prod.suno.com y copia el header Authorization
SUNO_TOKEN=
